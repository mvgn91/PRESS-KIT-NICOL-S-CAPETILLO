---
import data from '../data/nicolas.json';
import { opt } from '../lib/img';
const { demoReel } = data;
// Posters: YouTube hqdefault + frames extraídos de los clips (ffmpeg).
const ytId = 'GqD4yzR0Q_M';
const ytUrl = `https://www.youtube.com/watch?v=${ytId}`;
const ytThumb = `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
const posters = await Promise.all(
  demoReel.verticalVideos.map((_, i) => opt(`/assets/img/clips/poster-${i + 1}.jpg`, 640))
);
const items = [
  { kind: 'yt', title: demoReel.mainTitle, src: ytThumb, year: '2026' },
  ...demoReel.verticalVideos.map((v, i) => ({
    kind: 'clip',
    title: `Clip ${String(i + 1).padStart(2, '0')}`,
    src: posters[i],
    video: v.src,
    sub: 'Acting Lab',
  })),
];
const total = items.length;
---

<section class="reel section" id="demo-reel">
  <div class="container">
    <div class="section-header">
      <span class="section-number" aria-hidden="true">03</span>
      <h2 class="section-title">Demo Reel</h2>
    </div>

    <!-- ===== 3 TARJETAS FIJAS: voltean y reproducen in situ ===== -->
    <div class="rgrid" data-rgrid>
      {items.map((item, i) => (
        <article
          class="rcard"
          data-rcard={i}
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-label={`${item.title}: activar para voltear`}
        >
          <div class="rtilt">
            <div class="rflip">
              <div class="rface rfront" aria-hidden="false">
                <img src={item.src} alt="" loading="lazy" draggable="false" />
                <span class="rplay" aria-hidden="true">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16" fill="currentColor" stroke="none"/></svg>
                </span>
                <span class="rcap" aria-hidden="true">
                  <span class="rcap-text">{item.title}</span>
                  <span class="rcap-index">{String(i + 1).padStart(2, '0')}</span>
                </span>
              </div>
              <div class="rface rback ryt-back" aria-hidden="true">
                {item.kind === 'yt' ? (
                  <>
                    <button type="button" class="ryt-big" data-yt-open aria-label="Reproducir Demo Reel en grande">
                      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16" fill="currentColor" stroke="none"/></svg>
                      <span>Ver en grande</span>
                    </button>
                    <a class="ryt-open" href={ytUrl} target="_blank" rel="noopener noreferrer">Abrir en YouTube</a>
                  </>
                ) : (
                  <video src={item.video} poster={item.src} playsinline preload="none" controls></video>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="rhint">Toca una tarjeta para voltearla</p>
  </div>
</section>

<!-- ===== REEL GRANDE: YouTube al centro, buen tamaño ===== -->
<div class="ytview" id="ytView" role="dialog" aria-modal="true" aria-label="Demo Reel en grande">
  <div class="ytv-box">
    <div class="ytv-bar">
      <span class="ytv-title">Demo Reel 2026</span>
      <div class="ytv-actions">
        <a class="ytv-link" href={ytUrl} target="_blank" rel="noopener noreferrer">Abrir en YouTube</a>
        <button type="button" class="ytv-close" id="ytvClose" aria-label="Cerrar reproductor">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
    <div class="ytv-stage" data-yt-holder>
      <img src={ytThumb} alt="" loading="lazy" draggable="false" />
      <button type="button" class="ytv-play" data-ytv-play aria-label="Reproducir Demo Reel">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16" fill="currentColor" stroke="none"/></svg>
      </button>
    </div>
  </div>
</div>


<style>
  /* ==================================================================
     DEMO REEL — 3 tarjetas fijas: voltean y reproducen in situ
     Tilt al puntero + flip al clic. Una sola unidad.
     ================================================================== */
  .rgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-md);
    margin-top: var(--sp-xl);
    perspective: 1400px;
  }

  .rcard {
    aspect-ratio: 3 / 4;
    cursor: pointer;
  }

  .rcard:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .rtilt {
    height: 100%;
    transform: rotateX(var(--tx, 0deg)) rotateY(var(--ty, 0deg));
    transition: transform 0.18s ease-out;
    transform-style: preserve-3d;
  }

  .rflip {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateY(var(--flip, 0deg));
    transition: transform 0.6s var(--ease);
  }

  .rcard.is-flipped .rflip {
    --flip: 180deg;
  }

  .rface {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--line);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: border-color 0.3s var(--ease);
  }

  .rcard:hover .rface,
  .rcard.is-flipped .rface {
    border-color: var(--text);
  }

  .rface img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.15) contrast(1.04);
  }

  .rplay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(0, 0, 0, 0.22);
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
    pointer-events: none;
  }

  .rcap {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-md);
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
    pointer-events: none;
  }

  .rcap-text {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rcap-index {
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.72;
    font-variant-numeric: tabular-nums;
  }

  .rback {
    transform: rotateY(180deg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rback video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  /* Puerta al visor grande (solo YouTube; los clips juegan in situ) */
  .ryt-back {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-md);
    background: #000;
  }

  .ryt-big {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    color: #fff;
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
    transition: transform 0.25s var(--ease);
  }

  .ryt-big:hover {
    transform: scale(1.06);
  }

  .ryt-open {
    padding: 0.35rem 0.7rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  /* ===== VISOR GRANDE al centro ===== */
  .ytview {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(0, 0, 0, 0.92);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .ytview.active {
    display: flex;
    opacity: 1;
  }

  .ytv-box {
    width: min(960px, 94vw);
  }

  .ytv-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-md);
    margin-bottom: 0.6rem;
    color: #fff;
  }

  .ytv-title {
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  .ytv-close {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
  }

  .ytv-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }

  .ytv-stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ytv-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 88px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.6));
    transition: transform 0.25s var(--ease);
  }

  .ytv-play:hover {
    transform: scale(1.08);
  }

  .ytv-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .ytv-link {
    color: rgba(255, 255, 255, 0.72);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .ytv-link:hover {
    color: #fff;
    border-bottom-color: #fff;
  }

  /* El iframe nace por JS (sin el atributo de scoping de Astro): :global lo alcanza. */
  :global(.ytv-frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .rhint {
    margin-top: var(--sp-md);
    text-align: center;
    font-size: var(--fs-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 640px) {
    .rgrid {
      display: flex;
      gap: var(--sp-md);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: var(--sp-sm);
      margin-left: calc(-1 * var(--container));
      margin-right: calc(-1 * var(--container));
      padding-left: var(--container);
      padding-right: var(--container);
    }

    .rgrid::-webkit-scrollbar {
      display: none;
    }

    .rcard {
      flex: 0 0 240px;
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rtilt,
    .rflip {
      transition: none;
    }
  }

</style>

<script define:vars={{ ytId }}>
  // 3 tarjetas fijas: tilt al puntero + flip al clic/tap/Enter.
  // Al voltear, el clip se reproduce in situ; solo uno a la vez.
  (() => {
    const cards = [...document.querySelectorAll('[data-rcard]')];
    if (!cards.length) return;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MAX = 8;

    function setFlip(card, on) {
      cards.forEach((c) => {
        if (c !== card && c.classList.contains('is-flipped')) {
          c.classList.remove('is-flipped');
          c.setAttribute('aria-pressed', 'false');
          const vv = c.querySelector('video');
          if (vv) vv.pause();
          const ff = c.querySelectorAll('.rface');
          if (ff[0]) ff[0].setAttribute('aria-hidden', 'false');
          if (ff[1]) ff[1].setAttribute('aria-hidden', 'true');
        }
      });
      card.classList.toggle('is-flipped', on);
      card.setAttribute('aria-pressed', on ? 'true' : 'false');
      const faces = card.querySelectorAll('.rface');
      if (faces[0]) faces[0].setAttribute('aria-hidden', on ? 'true' : 'false');
      if (faces[1]) faces[1].setAttribute('aria-hidden', on ? 'false' : 'true');
      const v = card.querySelector('video');
      if (v) {
        if (on) v.play().catch(() => {});
        else v.pause();
      }
    }

    // Visor grande: fachada al centro, iframe pesado solo al play.
    const ytView = document.getElementById('ytView');
    const ytHolder = ytView?.querySelector('[data-yt-holder]');
    let ytLastFocused = null;

    function ytPlay() {
      if (!ytHolder || ytHolder.querySelector('iframe')) return;
      const f = document.createElement('iframe');
      f.className = 'ytv-frame';
      f.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
      f.title = 'Demo Reel 2026';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      ytHolder.prepend(f);
      const pb = ytHolder.querySelector('[data-ytv-play]');
      if (pb) pb.style.display = 'none';
    }

    // Abrir = reproducir en grande al centro (el gesto del clic habilita el autoplay).
    function ytOpen() {
      ytLastFocused = document.activeElement;
      ytView.classList.add('active');
      document.body.style.overflow = 'hidden';
      ytPlay();
      document.getElementById('ytvClose')?.focus();
    }

    function ytClose() {
      const fr = ytHolder?.querySelector('iframe');
      if (fr) fr.remove();
      const pb = ytHolder?.querySelector('[data-ytv-play]');
      if (pb) pb.style.display = '';
      ytView.classList.remove('active');
      document.body.style.overflow = '';
      if (ytLastFocused && ytLastFocused.focus) ytLastFocused.focus();
    }

    document.querySelectorAll('[data-yt-open]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        ytOpen();
      });
    });

    ytHolder?.querySelector('[data-ytv-play]')?.addEventListener('click', ytPlay);

    document.getElementById('ytvClose')?.addEventListener('click', ytClose);
    ytView?.addEventListener('click', (e) => { if (e.target === ytView) ytClose(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && ytView?.classList.contains('active')) ytClose();
    });

    cards.forEach((card) => {
      const tilt = card.querySelector('.rtilt');
      const toggle = () => setFlip(card, !card.classList.contains('is-flipped'));
      card.addEventListener('click', (e) => {
        if (e.target.closest('a, video, button, iframe')) return;
        toggle();
      });
      card.addEventListener('keydown', (e) => {
        if (e.target.closest('a, video, button')) return;
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
      });
      if (!fine || reduce || !tilt) return;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.setProperty('--ty', (px * MAX * 2).toFixed(2) + 'deg');
        tilt.style.setProperty('--tx', (-py * MAX * 2).toFixed(2) + 'deg');
      });
      card.addEventListener('pointerleave', () => {
        tilt.style.setProperty('--tx', '0deg');
        tilt.style.setProperty('--ty', '0deg');
      });
    });
  })();
</script>

