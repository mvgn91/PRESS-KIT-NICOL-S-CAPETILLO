---
import data from '../data/nicolas.json';
import { opt } from '../lib/img';
const { personal, physical, languages, timeline } = data;
const bioPhoto = await opt(personal.bioPhoto, 800);
// F3: ciudades base / residencia desde nicolas.json (se agregó Ciudad de México).
const basesCompact = (personal.bases ?? ['Guadalajara']).join(' · ');
const tlTotal = String(timeline.length).padStart(2, '0');
---

<section class="bio section" id="biografia">
  <div class="container">
    <div class="section-header">
      <span class="section-number" aria-hidden="true">01</span>
      <h2 class="section-title">Biografía</h2>
    </div>

    <!-- ===== BLOQUE 1 — EL ACTOR ===== -->
    <div class="bio-grid">
      <figure class="bio-portrait">
        <div class="bio-portrait-frame">
          <img src={bioPhoto} alt={personal.artistName} loading="eager" />
        </div>
      </figure>

      <div class="bio-text-col">
        <h3 class="bio-name">{personal.fullName}</h3>
        <p class="bio-role">{personal.subtitle}</p>
        <div class="bio-rule"></div>

        <div class="bio-text-wrap">
          <span class="bio-cap" aria-hidden="true">N</span>
          <p class="bio-text">{personal.bio.slice(1)}</p>
        </div>

        <a href="#filmografia" class="bio-cta">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span>Ver filmografía</span>
        </a>
      </div>
    </div>

    <!-- ===== BLOQUE 2 — TRAYECTORIA (carrusel) ===== -->
    <div class="bio-tl" data-tl>
      <div class="bio-tl-head">
        <div class="bio-tl-head-text">
          <span class="bio-tl-label">Trayectoria</span>
          <span class="bio-tl-counter"><span class="tl-cur">01</span> / {tlTotal}</span>
        </div>
        <div class="bio-tl-nav">
          <button type="button" class="bio-tl-btn" data-tl-prev aria-label="Hito anterior">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button" class="bio-tl-btn" data-tl-next aria-label="Hito siguiente">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>

      <div class="tl-view" tabindex="0" role="region" aria-label="Trayectoria: desliza para explorar los hitos">
        {timeline.map((item, i) => (
          <article class="tl-card" data-tl-card>
            <span class="tl-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="tl-year">{item.period}</span>
            <h4 class="tl-title">{item.title}</h4>
            <p class="tl-desc">{item.description}</p>
            {item.link && (
              <a href={item.link.url} target="_blank" rel="noopener noreferrer" class="tl-link">
                {item.link.text}
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            )}
          </article>
        ))}
      </div>

      <div class="tl-progress" aria-hidden="true">
        <span class="tl-fill"></span>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-tl]');
    if (!root) return;
    const view = root.querySelector('.tl-view');
    const fill = root.querySelector('.tl-fill');
    const cur = root.querySelector('.tl-cur');
    const cards = [...root.querySelectorAll('[data-tl-card]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const update = () => {
      const max = view.scrollWidth - view.clientWidth;
      const p = max > 0 ? view.scrollLeft / max : 0;
      fill.style.transform = `scaleX(${p})`;
      let best = 0;
      if (view.scrollLeft > 1) {
        const vc = view.scrollLeft + view.clientWidth / 2;
        let bd = Infinity;
        cards.forEach((c, i) => {
          const cc = c.offsetLeft + c.offsetWidth / 2;
          const d = Math.abs(cc - vc);
          if (d < bd) { bd = d; best = i; }
        });
      }
      cards.forEach((c, i) => c.classList.toggle('is-active', i === best));
      cur.textContent = String(best + 1).padStart(2, '0');
    };

    let tick = false;
    view.addEventListener('scroll', () => {
      if (tick) return;
      tick = true;
      requestAnimationFrame(() => { update(); tick = false; });
    }, { passive: true });

    const step = () => {
      const gap = 16;
      return (cards[0]?.offsetWidth ?? 300) + gap;
    };
    const go = (dir) => view.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });
    root.querySelector('[data-tl-prev]').addEventListener('click', () => go(-1));
    root.querySelector('[data-tl-next]').addEventListener('click', () => go(1));

    update();
  })();
</script>

<style>
  /* ==================================================================
     BIOGRAPHY — Dos bloques: el actor + trayectoria en carrusel
     ================================================================== */

  /* ===== BLOQUE 1: grid retrato + texto ===== */
  .bio-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: var(--sp-xl);
    align-items: start;
    margin-bottom: var(--sp-2xl);
  }

  .bio-portrait {
    margin: 0;
    position: sticky;
    top: calc(var(--nav-height) + var(--sp-lg));
  }

  /* Marco como el del hero: tinta que alterna con el tema. */
  .bio-portrait-frame {
    position: relative;
    overflow: hidden;
    background: var(--bg-alt);
    border: 6px solid var(--ink);
  }

  .bio-portrait-frame img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    filter: grayscale(0.2) contrast(1.04);
    transition: filter 0.8s var(--ease);
  }

  .bio-portrait-frame:hover img {
    filter: grayscale(0.75) contrast(1.08);
  }

  .bio-text-col {
    padding-top: var(--sp-sm);
  }

  .bio-name {
    font-size: var(--fs-h2);
    font-weight: 800;
    color: var(--text);
    margin: 0 0 0.25rem;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .bio-role {
    font-size: var(--fs-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--sp-md);
  }

  .bio-rule {
    width: 64px;
    height: 1px;
    background: var(--text);
    margin-bottom: var(--sp-md);
  }

  .bio-text-wrap {
    display: flow-root;
    margin-bottom: var(--sp-md);
  }

  /* La capitular es marca gráfica, fuera de la escala */
  .bio-cap {
    float: left;
    font-family: var(--font-heading);
    font-size: 4.5rem;
    font-weight: 900;
    line-height: 0.75;
    padding: 0.15rem 0.45rem 0 0;
    color: var(--text);
  }

  .bio-text {
    font-size: var(--fs-lead);
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  /* Los datos viven en la Ficha Técnica; aquí solo el relato. */

  .bio-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.7rem 1.5rem;
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    background: var(--ink);
    border: 1px solid var(--ink);
    transition: background 0.25s var(--ease), color 0.25s var(--ease);
  }

  .bio-cta:hover {
    background: transparent;
    color: var(--ink);
  }

  .bio-cta svg {
    width: 14px;
    height: 14px;
  }

  /* ===== BLOQUE 2: TRAYECTORIA — carrusel ===== */
  .bio-tl {
    padding-top: var(--sp-xl);
    border-top: 1px solid var(--line);
  }

  .bio-tl-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-md);
    margin-bottom: var(--sp-md);
  }

  .bio-tl-head-text {
    display: flex;
    align-items: baseline;
    gap: var(--sp-md);
  }

  .bio-tl-label {
    font-size: var(--fs-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .bio-tl-counter {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .bio-tl-counter .tl-cur {
    color: var(--text);
  }

  .bio-tl-nav {
    display: flex;
    gap: var(--sp-sm);
  }

  .bio-tl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    transition: background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .bio-tl-btn:hover {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .bio-tl-btn svg {
    width: 16px;
    height: 16px;
  }

  /* Riel de tarjetas */
  .tl-view {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--sp-md);
    scrollbar-width: none;
  }

  .tl-view::-webkit-scrollbar {
    display: none;
  }

  .tl-card {
    flex: 0 0 340px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: var(--sp-lg);
    background: transparent;
    border: 1px solid var(--line);
    transition: border-color 0.3s var(--ease);
  }

  .tl-card.is-active {
    border-color: var(--text);
  }

  .tl-index {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--sp-sm);
  }

  .tl-card.is-active .tl-index {
    color: var(--text);
  }

  .tl-year {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    overflow-wrap: break-word;
    margin-bottom: 0.35rem;
  }

  .tl-title {
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.4rem;
    line-height: 1.3;
  }

  .tl-desc {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  .tl-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.7rem;
    font-size: var(--fs-micro);
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--text);
    text-decoration: none;
    transition: gap 0.2s;
    align-self: flex-start;
  }

  .tl-link:hover {
    gap: 0.6rem;
  }

  .tl-link svg {
    width: 11px;
    height: 11px;
  }

  /* Riel de progreso: se llena con el scroll */
  .tl-progress {
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .tl-fill {
    display: block;
    height: 100%;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .bio-grid {
      grid-template-columns: 1fr;
    }

    .bio-portrait {
      position: static;
      max-width: 440px;
    }

    .bio-text-col {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .bio-grid {
      gap: var(--sp-lg);
      margin-bottom: var(--sp-xl);
    }

    .bio-portrait {
      max-width: none;
    }

    .bio-cap {
      font-size: 3rem;
    }

    .tl-card {
      flex-basis: 78vw;
    }

    .bio-tl-nav {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .bio-cta {
      width: 100%;
    }

    .bio-name {
      font-size: clamp(1.5rem, 6vw, 1.8rem);
    }

    .bio-cap {
      font-size: 2.6rem;
      padding: 0.1rem 0.3rem 0 0;
    }
  }

  /* Reduced motion: sin desplazamiento suave */
  @media (prefers-reduced-motion: reduce) {
    .tl-card { transition: none; }
    .bio-cta, .bio-tl-btn { transition: none; }
    .bio-portrait-frame img { transition: none !important; }
  }

  /* Touch devices */
  @media (hover: none) and (pointer: coarse) {
    .bio-portrait-frame:hover img {
      filter: grayscale(0.2) contrast(1.04);
    }
  }
</style>
