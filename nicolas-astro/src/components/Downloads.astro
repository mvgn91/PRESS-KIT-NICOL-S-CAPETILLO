---
import data from '../data/nicolas.json';
import { opt } from '../lib/img';
const { downloads, contact, physical, languages, personal, skills } = data;
const fichaPhoto = await opt(personal.fichaPhoto, 800);
// F3: ciudades base / residencia desde nicolas.json (se agregó Ciudad de México).
const basesLabel = `${(personal.bases ?? ['Guadalajara']).join(' · ')}, ${personal.baseCountry ?? 'MX'}`;
// Edad calculada en build desde la fecha de nacimiento (nunca caduca).
const MESES = { enero: 0, febrero: 1, marzo: 2, abril: 3, mayo: 4, junio: 5, julio: 6, agosto: 7, septiembre: 8, octubre: 9, noviembre: 10, diciembre: 11 };
let ageYears = parseInt(physical.age) || 47;
{
  const m = /(\d+)\s+de\s+([a-záéíóúñ]+)\s+de\s+(\d+)/i.exec(physical.birthDate ?? '');
  if (m) {
    const birth = new Date(Number(m[3]), MESES[m[2].toLowerCase()] ?? 0, Number(m[1]));
    const today = new Date();
    ageYears = today.getFullYear() - birth.getFullYear();
    if (today < new Date(today.getFullYear(), birth.getMonth(), birth.getDate())) ageYears -= 1;
  }
}
const ageLabel = `${ageYears} años`;
// Nivel de idioma → segmentos llenos de 3.
const langFill = (level) => /nativ|fluid|avanz|c2/i.test(level ?? '') ? 3 : /convers|intermedio|b2/i.test(level ?? '') ? 2 : 1;
// Secciones de la tarjeta (puntos numerados).
const slidesMeta = [
  { num: '01', label: 'Físico' },
  { num: '02', label: 'Perfil' },
  { num: '03', label: 'Idiomas' },
  { num: '04', label: 'Habilidades' },
];
---

<!-- ===== FICHA TÉCNICA — expediente ===== -->
<section class="fch section" id="ficha-tecnica">
  <div class="container">
    <div class="section-header">
      <span class="section-number" aria-hidden="true">05</span>
      <h2 class="section-title">Ficha Técnica</h2>
    </div>

    <div class="fcard" data-fcard>
      <div class="fcard-photo">
        <img src={fichaPhoto} alt="Fotografía de casting" loading="lazy" />
      </div>
      <div class="fcard-body">
        <div class="fcard-top">
          <div class="fcard-who">
            <h3 class="fch-name">{personal.fullName}</h3>
            <p class="fch-sub">{physical.nationality} · {basesLabel}</p>
          </div>
          <a class="fch-btn" href={downloads.photos.url} download="Nicolas-Capetillo-Fotos.zip" target="_blank" rel="noopener noreferrer">
            <span>Descargar fotos</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </a>
        </div>

        <div class="fslides" data-slides tabindex="0" role="region" aria-label="Ficha por secciones: usa las flechas para navegar">
          <div class="ftrack" data-track>
            <section class="fslide" aria-label="Físico">
              <dl class="fch-ledger">
                <div class="fch-ledger-row"><dt>Estatura</dt><dd>{physical.height}</dd></div>
                <div class="fch-ledger-row"><dt>Peso</dt><dd>{physical.weight}</dd></div>
                <div class="fch-ledger-row"><dt>Cabello</dt><dd>{physical.hair}</dd></div>
                <div class="fch-ledger-row"><dt>Ojos</dt><dd>{physical.eyes}</dd></div>
              </dl>
            </section>
            <section class="fslide" aria-label="Perfil">
              <dl class="fch-ledger">
                <div class="fch-ledger-row"><dt>Nacionalidad</dt><dd>{physical.nationality}</dd></div>
                <div class="fch-ledger-row"><dt>Edad</dt><dd>{ageLabel}</dd></div>
                <div class="fch-ledger-row"><dt>Nacimiento</dt><dd>{physical.birthDate}</dd></div>
                <div class="fch-ledger-row"><dt>Base</dt><dd>{basesLabel}</dd></div>
              </dl>
            </section>
            <section class="fslide" aria-label="Idiomas">
              <ul class="fch-langs">
                {languages.map((l) => (
                  <li class="fch-lang" aria-label={`${l.language}: ${l.level}`}>
                    <span class="fch-lang-top">
                      <span class="fch-lang-name">{l.language}</span>
                      <span class="fch-lang-level">{l.level}</span>
                    </span>
                    <span class="fch-bar" aria-hidden="true">
                      {[0, 1, 2].map((k) => <span class={k < langFill(l.level) ? 'on' : ''}></span>)}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
            <section class="fslide" aria-label="Habilidades">
              <div class="fch-skills-group">
                <span class="fch-skills-group-label">Artes y Música</span>
                <div class="fch-tags">
                  {skills.arts.map((s) => <span class="fch-tag">{s}</span>)}
                </div>
              </div>
              <div class="fch-skills-group">
                <span class="fch-skills-group-label">Físicas y Técnicas</span>
                <div class="fch-tags">
                  {skills.physical.map((s) => <span class="fch-tag">{s}</span>)}
                </div>
              </div>
            </section>
          </div>
        </div>

        <div class="fcard-nav">
          <div class="fdots" role="group" aria-label="Secciones de la ficha">
            {slidesMeta.map((s, i) => (
              <button type="button" class="fdot" data-dot={i} aria-label={s.label} aria-current={i === 0 ? 'true' : undefined}>
                <span aria-hidden="true">{s.num}</span>
              </button>
            ))}
          </div>
          <div class="fcard-arrows">
            <button type="button" class="fnav-btn" data-fprev aria-label="Sección anterior">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="fnav-btn" data-fnext aria-label="Sección siguiente">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Ficha en una sola tarjeta: slides internos con botones, teclado y swipe.
  (() => {
    const card = document.querySelector('[data-fcard]');
    if (!card) return;
    const track = card.querySelector('[data-track]');
    const dots = [...card.querySelectorAll('[data-dot]')];
    const region = card.querySelector('[data-slides]');
    const n = dots.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0;

    function go(i) {
      idx = (i + n) % n;
      track.style.transform = `translateX(-${idx * 100}%)`;
      // La tarjeta mide lo que mide el slide visible: sin huecos muertos.
      if (region) region.style.height = track.children[idx].offsetHeight + 'px';
      dots.forEach((d, k) => {
        if (k === idx) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
        d.classList.toggle('is-active', k === idx);
      });
    }

    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    card.querySelector('[data-fprev]')?.addEventListener('click', () => go(idx - 1));
    card.querySelector('[data-fnext]')?.addEventListener('click', () => go(idx + 1));
    region?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(idx - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(idx + 1); }
    });

    let sx = 0;
    region?.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    region?.addEventListener('touchend', (e) => {
      const dx = sx - e.changedTouches[0].clientX;
      if (Math.abs(dx) > 40) go(idx + (dx > 0 ? 1 : -1));
    }, { passive: true });

    window.addEventListener('resize', () => {
      if (region) region.style.height = track.children[idx].offsetHeight + 'px';
    });

    if (reduce) track.style.transition = 'none';
    go(0);
  })();
</script>



<!-- ===== CONTACTO ===== -->
<section class="cnc section" id="contacto">
  <div class="container">
    <div class="section-header">
      <span class="section-number" aria-hidden="true">06</span>
      <h2 class="section-title">Contacto</h2>
    </div>

    <p class="cnc-lead">¿Interesado en colaborar? Estoy disponible para nuevos proyectos. Contáctame directamente, a través de mi representación, o descarga mi material profesional.</p>

    <div class="cnc-cards">
      <!-- Directo -->
      <div class="cnc-card">
        <span class="cnc-card-label">Directo</span>
        <p class="cnc-card-name">{personal.artistName}</p>
        <ul class="cnc-card-list">
          <li>
            <a href={`mailto:${contact.direct.email}`} class="cnc-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span>{contact.direct.email}</span>
            </a>
          </li>
          <li>
            <a href={`tel:${contact.direct.phone.replace(/\s/g, '')}`} class="cnc-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>{contact.direct.phone}</span>
            </a>
          </li>
          {contact.social.map((s) => (
            <li>
              <a href={s.url} class="cnc-link" target="_blank" rel="noopener noreferrer">
                {s.name === 'Instagram' ? (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                ) : (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                )}
                <span>{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Representación -->
      <div class="cnc-card">
        <span class="cnc-card-label">Representación</span>
        <p class="cnc-card-name">{contact.manager.name}</p>
        <p class="cnc-card-meta">{contact.manager.agency}</p>
        <ul class="cnc-card-list">
          <li>
            <a href={`mailto:${contact.manager.email}`} class="cnc-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span>{contact.manager.email}</span>
            </a>
          </li>
          <li>
            <a href={`tel:${contact.manager.phone.replace(/\s/g, '')}`} class="cnc-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>{contact.manager.phone}</span>
            </a>
          </li>
          <li>
            <a href={contact.manager.agencyUrl} class="cnc-link" target="_blank" rel="noopener noreferrer">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              <span>{contact.manager.agency}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Material -->
      <div class="cnc-card cnc-card--material">
        <span class="cnc-card-label">Material</span>
        <p class="cnc-card-name">{downloads.photos.label}</p>
        <p class="cnc-card-meta">{downloads.photos.description}</p>
        <a href={downloads.photos.url} class="cnc-button" download="Nicolas-Capetillo-Fotos.zip" target="_blank" rel="noopener noreferrer">
          <span>Descargar ZIP</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </a>
        <ul class="cnc-card-list cnc-card-list--inline">
          <li><a href="#ficha-tecnica" class="cnc-link"><span>{downloads.fichaTecnica.label}</span></a></li>
          <li><a href="#demo-reel" class="cnc-link"><span>{data.demoReel.mainTitle}</span></a></li>
        </ul>
      </div>
    </div>
  </div>
</section>


<style>
  /* ===== CONTACTO — cierre simple (F3) =====
     Tres tarjetas contenidas. Reglas de 1px, sin vidrio, sin rejillas de filas. */

  .cnc-lead {
    max-width: 62ch;
    margin-bottom: var(--sp-xl);
    color: var(--text-secondary);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  .cnc-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-lg);
    align-items: stretch;
  }

  .cnc-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--sp-lg);
    border: 1px solid var(--line);
  }

  .cnc-card--material {
    background: var(--bg-alt);
  }

  .cnc-card-label {
    color: var(--text-muted);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cnc-card-name {
    margin-top: var(--sp-sm);
    color: var(--text);
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .cnc-card-meta {
    margin-top: 0.15rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .cnc-card-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: var(--sp-md);
    list-style: none;
  }

  .cnc-card-list--inline {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.4rem var(--sp-lg);
    margin-top: var(--sp-md);
  }

  .cnc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: var(--fs-small);
    border-bottom: 1px solid transparent;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .cnc-link:hover {
    color: var(--text);
    border-bottom-color: var(--text);
  }

  .cnc-link svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: var(--text-muted);
    transition: color 0.25s var(--ease);
  }

  .cnc-link:hover svg {
    color: var(--text);
  }

  /* Botón primario del cierre (invertido, igual que el del hero) */
  .cnc-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    align-self: flex-start;
    min-height: 44px;
    margin-top: var(--sp-md);
    padding: 0.7rem 1.1rem;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1;
    transition: background 0.25s var(--ease), color 0.25s var(--ease);
  }

  .cnc-button:hover {
    background: transparent;
    color: var(--text);
  }

  /* ===== FICHA TÉCNICA — expediente ===== */
  /* ---- Tarjeta expediente única ---- */
  .fcard {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    margin-top: var(--sp-xl);
    border: 2px solid var(--ink);
  }

  .fcard-photo {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--bg-alt);
  }

  .fcard-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    filter: grayscale(0.2) contrast(1.04);
  }

  .fcard-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--sp-xl);
  }

  .fcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-md);
    padding-bottom: var(--sp-md);
    border-bottom: 1px solid var(--line);
  }

  /* ---- Slides internos ---- */
  .fslides {
    overflow: hidden;
    margin-top: var(--sp-md);
    transition: height 0.45s var(--ease);
  }

  .ftrack {
    display: flex;
    align-items: flex-start;
    transition: transform 0.45s var(--ease);
  }

  .fslide {
    flex: 0 0 100%;
    min-width: 0;
    padding-bottom: var(--sp-sm);
  }

  /* ---- Navegación: puntos + flechas ---- */
  .fcard-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-md);
    margin-top: auto;
    padding-top: var(--sp-md);
    border-top: 1px solid var(--line);
  }

  .fdots {
    display: flex;
    gap: 0.35rem;
  }

  .fdot {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.7rem;
    background: none;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .fdot:hover {
    color: var(--text);
  }

  .fdot.is-active {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .fcard-arrows {
    display: flex;
    gap: var(--sp-sm);
  }

  .fnav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    cursor: pointer;
    transition: background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .fnav-btn:hover {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  /* ---- Libro mayor ---- */
  .fch-ledger {
    margin: 0;
    max-width: 760px;
  }

  .fch-ledger-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--sp-md);
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .fch-ledger-row:first-child {
    border-top: 1px solid var(--line);
  }

  .fch-ledger-row dt {
    font-size: var(--fs-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .fch-ledger-row dd {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--text);
  }

  /* ---- Idiomas con barras ---- */
  .fch-langs {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 760px;
  }

  .fch-lang {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .fch-lang:first-child {
    border-top: 1px solid var(--line);
  }

  .fch-lang-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-md);
  }

  .fch-lang-name {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--text);
  }

  .fch-lang-level {
    font-size: var(--fs-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .fch-bar {
    display: flex;
    gap: 4px;
    margin-top: 0.45rem;
  }

  .fch-bar span {
    height: 4px;
    flex: 1;
    background: var(--line);
  }

  .fch-bar span.on {
    background: var(--text);
  }

  /* ---- Habilidades ---- */
  .fch-skills-group + .fch-skills-group {
    margin-top: var(--sp-lg);
  }

  .fch-skills-group-label {
    display: block;
    font-size: var(--fs-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
